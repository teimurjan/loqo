# Postgres — docker-compose provides this by default (host port POSTGRES_PORT, 5433 unless set).
DATABASE_URL=postgres://opendeepl:opendeepl@localhost:5433/opendeepl

# Google Sign-In (OAuth client of type "Web application").
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Provider keys consumed by translate.config.ts
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Where the app listens.
PORT=3000

# Worker tuning. A group is one locale's worth of targets going through the layers together;
# throughput is roughly CONCURRENCY x BATCH_SIZE targets per group latency (~20-30 s for two layers),
# so a bulk run wants CONCURRENCY in the hundreds, DATABASE_POOL_SIZE around 20-30, and a provider
# tier that takes ~1k requests/min. A 429 pauses the whole provider for its Retry-After; each call
# gets MAX_RETRIES such waits before its group fails and the queue retries it.
TRANSLATE_BATCH_SIZE=20
TRANSLATE_CONCURRENCY=2
TRANSLATE_MAX_RETRIES=5
DATABASE_POOL_SIZE=10
